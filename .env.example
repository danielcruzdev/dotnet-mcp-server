# ============================================================
# Variáveis de ambiente suportadas pelo DotNetMcpServer
# Copie este arquivo para .env e preencha os valores.
# ============================================================

# OpenAI
OPENAI_API_KEY=sk-sua-chave-aqui
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEMPERATURE=0.2

# MCP Server
MCP_COMMAND=dotnet
MCP_ARGUMENTS=run --project src/DotNetMcpServer.Server/DotNetMcpServer.Server.csproj
MCP_WORKING_DIRECTORY=.
MCP_WORKSPACE_ROOT=.

# Agent Runtime
AGENT_MAX_TOOL_ITERATIONS=6
