# ============================================================
# Environment variables supported by DotNetMcpServer.
# Copy this file to .env and fill in the values.
# ============================================================

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEMPERATURE=0.2

# MCP server
#
# Leave MCP_COMMAND unset unless you are pointing the agent at a server outside this
# repository. Blank means the agent resolves the compiled binary itself, which is what you
# want: `dotnet run` writes MSBuild output to stdout, and stdout is the MCP protocol channel,
# so a single build warning corrupts the session.
#
# MCP_COMMAND=/absolute/path/to/DotNetMcpServer.Server
# MCP_ARGUMENTS=
MCP_WORKING_DIRECTORY=.
MCP_WORKSPACE_ROOT=.

# Agent runtime
# Must be between 1 and 12. An out-of-range value fails at startup rather than being clamped.
AGENT_MAX_TOOL_ITERATIONS=6
