<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tool logic is internal; the test project asserts on it directly. -->
    <InternalsVisibleTo Include="DotNetMcpServer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The AspNetCore package carries a FrameworkReference to Microsoft.AspNetCore.App, so the
      HTTP transport is available without moving this project onto Microsoft.NET.Sdk.Web.
      stdio remains the default and is unaffected by its presence.
    -->
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

</Project>
